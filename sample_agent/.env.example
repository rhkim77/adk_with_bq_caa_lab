# ============================================================================
# Google ADK Keyless Enterprise Configuration (.env.example)
# Corporate Policy Compliant: NO GOOGLE_API_KEY / AI Studio Key used.
# ============================================================================

# [Alternative 1] Vertex AI + Keyless OAuth ADC (Default & Recommended)
# Prerequisite:
#   gcloud config set project ryan-sandbox-agent
#   gcloud auth application-default login
#   gcloud auth application-default set-quota-project ryan-sandbox-agent
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_GENAI_USE_ENTERPRISE=TRUE
GOOGLE_CLOUD_PROJECT=ryan-sandbox-agent
# Use 'us-central1' for GA models (gemini-2.5-flash/pro) or 'global' for preview models (gemini-3.5-flash)
GOOGLE_CLOUD_LOCATION=us-central1
